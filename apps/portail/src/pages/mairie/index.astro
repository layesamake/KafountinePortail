---
import Base from '../../layouts/Base.astro';
import { getPortalSettings, getPortalServices, getPortalAgents } from '../../lib/content';

const settings = getPortalSettings();
const [services, agents] = await Promise.all([
  getPortalServices(),
  getPortalAgents(),
]);
---
<Base title="La mairie" description={`Informations pratiques et institutionnelles de ${settings.denomination}.`}>
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">LA MAIRIE</p>
      <h1>La mairie de Kafountine</h1>
      <p>Retrouvez l’organisation de la commune, les coordonnées d’accueil et les informations institutionnelles validées.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-grid">
      <article class="content-card">
        <p class="eyebrow">IDENTITÉ DE LA COMMUNE</p>
        <h2>Une commune au service de ses habitants</h2>
        <p>{settings.presentation}</p>
        <dl class="facts-list">
          <div><dt>Région</dt><dd>{settings.region}</dd></div>
          <div><dt>Département</dt><dd>{settings.departement}</dd></div>
          <div><dt>Arrondissement</dt><dd>{settings.arrondissement}</dd></div>
        </dl>
      </article>
      <article class="content-card" id="coordonnees">
        <p class="eyebrow">INFORMATIONS PRATIQUES</p>
        <h2>Coordonnées et horaires</h2>
        <p>{settings.address}</p>
        <p><strong>{settings.telephone}</strong><br />{settings.email}</p>
        <h3>Horaires d’accueil</h3>
        <dl class="hours-list">
          {settings.hours.map((entry) => <div><dt>{entry.day}</dt><dd>{entry.value}</dd></div>)}
        </dl>
      </article>
    </div>
  </section>

  <section class="section section-split" aria-labelledby="organisation-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">ORGANISATION ADMINISTRATIVE</p><h2 id="organisation-title">Les services de la mairie</h2></div>
        <span class="text-link">{services.length} services publiés</span>
      </div>
      {services.length > 0 ? (
        <div class="service-grid">
          {services.map((service, index) => (
            <a class="service-card" href={`/services/${service.slug}/`}>
              <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="service-content"><strong set:html={service.title.rendered}></strong><span>Voir la fiche du service</span></span>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state"><h2>Les services municipaux seront bientôt disponibles.</h2></div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="agents-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">ÉQUIPE MUNICIPALE</p><h2 id="agents-title">Agents et responsables</h2></div>
        <span class="text-link">{agents.length} agents publiés</span>
      </div>
      {agents.length > 0 ? (
        <div class="member-grid">
          {agents.map((agent, index) => (
            <article class="member-card">
              <span class="member-number">{String(index + 1).padStart(2, '0')}</span>
              <h3 set:html={agent.title.rendered}></h3>
              <p>Agent ou responsable municipal</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state"><h2>Les agents municipaux seront bientôt disponibles.</h2></div>
      )}
    </div>
  </section>
</Base>
