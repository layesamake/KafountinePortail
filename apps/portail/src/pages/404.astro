---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="La page demandée n’existe pas sur le portail citoyen de la commune de Kafountine.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">ERREUR 404</p>
      <h1>Cette page n’existe pas.</h1>
      <p>Le contenu recherché a peut-être été déplacé ou n’est pas encore publié.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Retour à l’accueil</a>
        <a class="button button-secondary" href="/recherche/">Rechercher une information</a>
      </div>
    </div>
  </section>
</Base>
