---
import Base from '../../layouts/Base.astro';
import { getPortalCommissions, getPortalCouncilMembers, getPortalSessions } from '../../lib/content';

const [members, commissions, sessions] = await Promise.all([
  getPortalCouncilMembers(),
  getPortalCommissions(),
  getPortalSessions(),
]);

const formatDate = (value: string) => {
  const [year, month, day] = value.slice(0, 10).split('-').map(Number);
  return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(new Date(year, month - 1, day));
};
---
<Base title="Conseil municipal" description="Les élus, commissions et sessions du Conseil municipal de Kafountine.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">CONSEIL MUNICIPAL</p>
      <h1>Le conseil municipal</h1>
      <p>Découvrez les élus et les commissions qui participent à la vie institutionnelle de la commune de Kafountine.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="members-title">
    <div class="container">
      {members.length > 0 ? (
        <>
          <div class="section-heading">
            <div><p class="eyebrow">ASSEMBLÉE COMMUNALE</p><h2 id="members-title">Les élus municipaux</h2></div>
            <span class="text-link">{members.length} élus publiés</span>
          </div>
          <div class="member-grid">
            {members.map((member, index) => (
              <a class="member-card" href={`/conseil/elus/${member.slug}/`}>
                <span class="member-number">{String(index + 1).padStart(2, '0')}</span>
                <h3 set:html={member.title.rendered}></h3>
                <p>Membre du Conseil municipal</p>
              </a>
            ))}
          </div>
        </>
      ) : (
        <div class="empty-state"><h2>Les élus municipaux seront bientôt disponibles.</h2></div>
      )}
    </div>
  </section>

  <section class="section section-split" aria-labelledby="commissions-title">
    <div class="container">
      {commissions.length > 0 ? (
        <>
          <div class="section-heading">
            <div><p class="eyebrow">TRAVAIL THÉMATIQUE</p><h2 id="commissions-title">Les commissions municipales</h2></div>
            <span class="text-link">{commissions.length} commissions publiées</span>
          </div>
          <div class="commission-grid">
            {commissions.map((commission, index) => (
              <a class="commission-card" href={`/conseil/commissions/${commission.slug}/`}>
                <span class="commission-number">{String(index + 1).padStart(2, '0')}</span>
                <h3 set:html={commission.title.rendered}></h3>
                <div class="cms-content" set:html={commission.content.rendered}></div>
              </a>
            ))}
          </div>
        </>
      ) : (
        <div class="empty-state"><h2>Les commissions municipales seront bientôt disponibles.</h2></div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="sessions-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">RÉUNIONS PUBLIQUES</p><h2 id="sessions-title">Sessions du conseil municipal</h2></div>
        <span class="text-link">{sessions.length} sessions publiées</span>
      </div>
      {sessions.length > 0 ? (
        <div class="document-grid">
          {sessions.map((session, index) => (
            <a class="document-card" href={`/conseil/sessions/${session.slug}/`}>
              <span class="document-number">{String(index + 1).padStart(2, '0')}</span>
              <p class="card-label">{formatDate(session.date)}</p>
              <h3 set:html={session.title.rendered}></h3>
              <div class="cms-content" set:html={session.excerpt.rendered || session.content.rendered}></div>
              <span class="text-link">Voir la session →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-state-number">En cours de publication</span>
          <h3>Aucune session du conseil municipal n’est encore publiée.</h3>
          <p>Les comptes rendus et dates de session seront ajoutés après validation par la commune.</p>
        </div>
      )}
    </div>
  </section>
</Base>