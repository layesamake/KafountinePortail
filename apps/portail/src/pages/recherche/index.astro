---
import Base from '../../layouts/Base.astro';
import { getPortalSearchEntries } from '../../lib/content';

const entries = await getPortalSearchEntries();
const supportedSearchTypes = [
  'Alerte communale',
  'Agent municipal',
  'Commission municipale',
  'Démarche administrative',
  'Document public',
  'Élu municipal',
  'Événement communal',
  'Marché public',
  'Projet municipal',
  'Service municipal',
  'Session du conseil municipal',
  'Village ou zone',
];
const searchTypes = [...new Set([...supportedSearchTypes, ...entries.map((entry) => entry.type)])].sort((a, b) => a.localeCompare(b, 'fr'));
---
<Base title="Recherche" description="Recherchez un service, un élu, une commission ou un village sur le portail citoyen de Kafountine.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">RECHERCHE</p>
      <h1>Trouvez rapidement la bonne information.</h1>
      <p>Recherchez dans les services municipaux, le conseil municipal, les villages et les informations publiques publiées sur le portail.</p>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <form class="search-form" id="portal-search-form" role="search">
        <label for="portal-search-input">Que recherchez-vous ?</label>
        <div class="search-form-row">
          <input id="portal-search-input" name="q" type="search" placeholder="Ex. état civil, Abéné, sécurité…" autocomplete="off" />
          <button class="button button-primary" type="submit">Rechercher</button>
        </div>
      </form>
      <div class="filter-bar search-filter">
        <label for="portal-search-type">Filtrer par type de contenu</label>
        <select id="portal-search-type" name="type">
          <option value="">Tous les types</option>
          {searchTypes.map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>
      <p class="search-status" id="portal-search-status" aria-live="polite">Saisissez un mot-clé pour commencer.</p>
      <div class="search-results" id="portal-search-results"></div>
      <noscript>
        <div class="empty-state">
          <h2>La recherche nécessite JavaScript.</h2>
          <p>Vous pouvez parcourir directement les <a href="/services/">services municipaux</a>, le <a href="/conseil/">conseil municipal</a> et les <a href="/villages/">villages</a>.</p>
        </div>
      </noscript>
    </div>
  </section>
</Base>

<script define:vars={{ entries }}>
  const searchEntries = entries;
  const form = document.querySelector('#portal-search-form');
  const input = document.querySelector('#portal-search-input');
  const typeFilter = document.querySelector('#portal-search-type');
  const status = document.querySelector('#portal-search-status');
  const results = document.querySelector('#portal-search-results');

  const normalise = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

  const render = (rawQuery, rawType) => {
    const query = normalise(rawQuery);
    const selectedType = rawType || '';
    results.replaceChildren();
    if (!query) {
      status.textContent = 'Saisissez un mot-clé pour commencer.';
      return;
    }

    const matches = searchEntries
      .filter((entry) => (!selectedType || entry.type === selectedType) && normalise(`${entry.title} ${entry.excerpt} ${entry.type}`).includes(query))
      .slice(0, 50);
    status.textContent = matches.length === 1 ? '1 résultat trouvé.' : `${matches.length} résultats trouvés.`;

    if (matches.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'empty-state';
      empty.innerHTML = '<h2>Aucun résultat pour ces critères.</h2><p>Modifiez le mot-clé ou le type de contenu sélectionné.</p>';
      results.append(empty);
      return;
    }

    for (const entry of matches) {
      const card = document.createElement('a');
      card.className = 'search-result-card';
      card.href = entry.href;
      const type = document.createElement('span');
      type.className = 'card-label';
      type.textContent = entry.type;
      const title = document.createElement('h2');
      title.textContent = entry.title;
      const excerpt = document.createElement('p');
      excerpt.textContent = entry.excerpt;
      card.append(type, title, excerpt);
      results.append(card);
    }
  };

  const updateUrl = () => {
    const url = new URL(window.location.href);
    const query = input?.value.trim() ?? '';
    const selectedType = typeFilter?.value ?? '';
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    if (selectedType) url.searchParams.set('type', selectedType);
    else url.searchParams.delete('type');
    window.history.replaceState({}, '', url);
    render(query, selectedType);
  };

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  const initialType = params.get('type') || '';
  if (input) input.value = initialQuery;
  if (typeFilter) typeFilter.value = initialType;
  render(initialQuery, initialType);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    updateUrl();
  });
  typeFilter?.addEventListener('change', updateUrl);
</script>
