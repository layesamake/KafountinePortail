        "rows": 4,
        "instructions": "Source(s) du financement, partenaires et montants publiables.",
        "new_lines": ""
      },
      {
        "key": "field_ck_projet_budget",
        "label": "Budget total communiqué (FCFA)",
        "name": "budget_total",
        "type": "number",
        "min": 0,
        "step": 1,
        "append": "FCFA",
