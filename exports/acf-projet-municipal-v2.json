[
  {
    "key": "group_ck_projet_v2",
    "title": "Projet municipal",
    "fields": [
      {
        "key": "field_ck_projet_statut",
        "label": "Statut du projet",
        "name": "statut_projet",
        "type": "radio",
        "required": 1,
        "choices": {
          "À faire": "À faire",
          "En cours": "En cours",
          "Terminé": "Terminé"
